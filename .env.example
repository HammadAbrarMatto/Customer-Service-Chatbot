# Required for answers — free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional
CHAT_MODEL=gemini-3.6-flash
VISION_MODEL=gemini-3.6-flash
EMBEDDING_BACKEND=local          # local (FastEmbed, free, no rate limits) | gemini
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MIN_RELEVANCE=0.35               # cosine threshold below which FAQ matches are ignored
